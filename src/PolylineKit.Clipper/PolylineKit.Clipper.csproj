<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>PolylineKit</AssemblyName>
    <RootNamespace>PolylineKit</RootNamespace>
    <PackageId>PolylineKit.Clipper</PackageId>
    <Version>0.1.0-alpha.2</Version>
    <Authors>PolylineKit contributors</Authors>
    <Description>Optional Clipper2 integration for quantized area comparisons and operations that also need resulting contours.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bgtnt/polylinekit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bgtnt/polylinekit</PackageProjectUrl>
    <PackageTags>geometry;polygon;polyline;area;alignment;iou;overlap;contours;clipping;intersection;fill-rule</PackageTags>
    <PackageReleaseNotes>https://github.com/bgtnt/polylinekit/blob/main/docs/releases/0.1.0-alpha.2.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PolylineKit.Core/PolylineKit.Core.csproj" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="PolylineKit.Experiments" />
  </ItemGroup>
</Project>
