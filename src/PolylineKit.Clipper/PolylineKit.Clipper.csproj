<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>PolylineKit</AssemblyName>
    <RootNamespace>PolylineKit</RootNamespace>
    <PackageId>PolylineKit.Clipper</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>PolylineKit contributors</Authors>
    <Description>Optional Clipper2 contour output and decimal-grid compatibility operations for PolylineKit.Core.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bgtnt/polylinekit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bgtnt/polylinekit</PackageProjectUrl>
    <PackageTags>geometry;polyline;area;alignment</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PolylineKit.Core/PolylineKit.Core.csproj" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="PolylineKit.Experiments" />
  </ItemGroup>
</Project>
