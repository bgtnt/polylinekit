<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>PolylineKit.Winding</AssemblyName>
    <RootNamespace>PolylineKit</RootNamespace>
    <PackageId>PolylineKit.Core</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>PolylineKit contributors</Authors>
    <Description>Dependency-free polyline areas, region overlap, transforms, normalization, sampling and alignment.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bgtnt/polylinekit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="PolylineKit.Experiments" />
    <!-- The optional compatibility adapter reuses input validation without a reverse runtime dependency. -->
    <InternalsVisibleTo Include="PolylineKit" />
  </ItemGroup>
</Project>
