<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>PolylineKit.Winding</AssemblyName>
    <RootNamespace>PolylineKit</RootNamespace>
    <PackageId>PolylineKit.Core</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>PolylineKit contributors</Authors>
    <Description>.NET methods for numeric area and region overlap, with no external runtime dependencies. Includes self-intersecting paths with explicit fill rules.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bgtnt/polylinekit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bgtnt/polylinekit</PackageProjectUrl>
    <PackageTags>geometry;polygon;polyline;area;intersection;coverage</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="PolylineKit.Experiments" />
    <!-- The optional compatibility adapter reuses input validation without a reverse runtime dependency. -->
    <InternalsVisibleTo Include="PolylineKit" />
  </ItemGroup>
</Project>
