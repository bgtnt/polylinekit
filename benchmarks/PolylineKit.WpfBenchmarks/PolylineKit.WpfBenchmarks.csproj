<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Optional Windows host for the SAME experiment, inputs, gates and competing methods. -->
    <Compile Include="../../examples/RegionCoverage/*.cs" Link="Experiment/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/PolylineKit.Winding/PolylineKit.Winding.csproj" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <None Include="../../examples/RegionCoverage/data/**/*.json" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
