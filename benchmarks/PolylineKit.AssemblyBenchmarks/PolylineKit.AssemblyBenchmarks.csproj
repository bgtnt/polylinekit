<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the hint assembly on clean checkouts without copying it to this runner's output. -->
    <ProjectReference Include="../../src/PolylineKit/PolylineKit.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="PolylineKit">
      <HintPath>../../src/PolylineKit/bin/$(Configuration)/net10.0/PolylineKit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="../Shared/Fixtures.cs" Link="Fixtures.cs" />
    <Compile Include="../Shared/FreshFixtures.cs" Link="FreshFixtures.cs" />
    <Compile Include="../Shared/ExactAreaOracle.cs" Link="ExactAreaOracle.cs" />
  </ItemGroup>
</Project>
