<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreFallbackFolders></RestoreFallbackFolders>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately consume the published package, never the source project. -->
    <PackageReference Include="PolylineKit.Core" Version="[0.1.0-alpha.2]" />
    <PackageReference Include="Clipper2" Version="[2.0.0]" />
    <PackageReference Include="NetTopologySuite" Version="[2.6.0]" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="release-profiles.json" LogicalName="PolylineKit.IndependentRegions.ReleaseProfiles" />
  </ItemGroup>
  <ItemGroup Condition="'$(AssessmentRevision)' != '' and '$(AssessmentSourceState)' != ''">
    <AssemblyMetadata Include="AssessmentRevision" Value="$(AssessmentRevision)" />
    <AssemblyMetadata Include="AssessmentSourceState" Value="$(AssessmentSourceState)" />
  </ItemGroup>
</Project>
