+    // A balanced preorder tree of leaf groups. Children are contiguous, so traversal needs no stack.
+    // Each edge contributes to exactly one leaf; every parent is the union of its two children.
+    private static int BuildBoundsTree(BoundsNode[] tree, int[] leaves, SweepBounds[] bounds, int firstGroup, int groups, int n, ref int count)
+    {
+        int node = count++;
+        int first = firstGroup * BoundsLeafSize, end = Math.Min(n, (firstGroup + groups) * BoundsLeafSize);
+        double min, max;
+        if (groups == 1)
+        {
+            leaves[firstGroup] = node;
+            min = bounds[first].MinOther; max = bounds[first].MaxOther;
+            for (int edge = first + 1; edge < end; edge++)
+            {
+                if (bounds[edge].MinOther < min) min = bounds[edge].MinOther;
+                if (bounds[edge].MaxOther > max) max = bounds[edge].MaxOther;
+            }
+        }
+        else
+        {
+            int leftGroups = groups / 2;
+            int left = BuildBoundsTree(tree, leaves, bounds, firstGroup, leftGroups, n, ref count);
+            int right = BuildBoundsTree(tree, leaves, bounds, firstGroup + leftGroups, groups - leftGroups, n, ref count);
+            min = Math.Min(tree[left].MinOther, tree[right].MinOther);
+            max = Math.Max(tree[left].MaxOther, tree[right].MaxOther);
+        }
+        tree[node] = new BoundsNode { First = first, End = end, Escape = count, MinOther = min, MaxOther = max };
+        return node;
+    }
